# Frontend (used at build time by Next.js)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Backend API
DATABASE_URL=postgresql+psycopg2://app_user:app_password@localhost:5433/app_db
REDIS_URL=redis://localhost:6379/0

# Upload & processing limits
MAX_UPLOAD_MB=100              # Per-request upload limit (MB)
MAX_AUDIO_DURATION=600         # Max single-file duration (seconds, 600 = 10 min)
JOB_TIMEOUT=300                # Pack generation timeout (seconds, 300 = 5 min)

# Cleanup
PACK_TTL_HOURS=24              # Auto-delete pack dirs older than this

# CORS (comma-separated origins, or * for any)
CORS_ORIGINS=http://localhost:3000
